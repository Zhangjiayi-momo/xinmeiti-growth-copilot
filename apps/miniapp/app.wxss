page { background: #f3f6f7; color: #172124; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.page { padding: 28rpx 24rpx 48rpx; }
.hero { padding: 34rpx 30rpx; border-radius: 28rpx; color: #fff; background: linear-gradient(145deg, #173b3e, #0f766e); box-shadow: 0 18rpx 38rpx rgba(15,118,110,.16); }
.hero-title { display: block; font-size: 42rpx; font-weight: 800; }
.hero-sub { display: block; margin-top: 12rpx; color: rgba(255,255,255,.72); font-size: 24rpx; line-height: 1.6; }
.section { margin-top: 28rpx; }
.section-title { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18rpx; font-size: 28rpx; font-weight: 800; }
.stat-grid { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 22rpx; }
.stat { width: calc(50% - 8rpx); margin-bottom: 16rpx; padding: 22rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(22,43,47,.06); }
.stat-label { color: #718084; font-size: 22rpx; }
.stat-value { display: block; margin-top: 12rpx; font-size: 38rpx; font-weight: 800; }
.stat-note { display: block; margin-top: 8rpx; color: #849297; font-size: 20rpx; }
.card { padding: 24rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(22,43,47,.06); }
.card + .card { margin-top: 16rpx; }
.card-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 18rpx; }
.card-title { display: block; font-size: 28rpx; font-weight: 800; }
.card-sub { display: block; margin-top: 8rpx; color: #718084; font-size: 21rpx; line-height: 1.5; }
.badge { padding: 8rpx 13rpx; border-radius: 999rpx; color: #0a6e66; background: #e6f6f3; font-size: 19rpx; white-space: nowrap; }
.metrics { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 20rpx; }
.metric { width: calc(33.333% - 8rpx); margin-bottom: 12rpx; padding: 15rpx; border-radius: 16rpx; background: #f7faf9; }
.metric-label { display: block; color: #718084; font-size: 19rpx; }
.metric-value { display: block; margin-top: 7rpx; font-size: 25rpx; font-weight: 800; }
.primary-btn, .secondary-btn, .danger-btn { margin-top: 18rpx; border-radius: 18rpx; font-size: 27rpx; font-weight: 700; }
.primary-btn { color: #fff; background: #0f8f83; }
.secondary-btn { color: #173b3e; background: #e5f4f1; }
.danger-btn { color: #a63b3b; background: #ffeded; }
.empty { padding: 70rpx 20rpx; text-align: center; color: #718084; }
.empty-title { display: block; color: #172124; font-size: 30rpx; font-weight: 800; }
.empty-sub { display: block; margin-top: 12rpx; font-size: 23rpx; }
.filter-bar { display: flex; gap: 12rpx; overflow-x: auto; padding: 4rpx 0 14rpx; }
.filter-chip { flex: 0 0 auto; padding: 12rpx 20rpx; border-radius: 999rpx; color: #647378; background: #e9efef; font-size: 22rpx; }
.filter-chip.active { color: #fff; background: #0f8f83; }
.form-card { padding: 26rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(22,43,47,.06); }
.form-group { margin-top: 24rpx; }
.form-label { display: block; margin-bottom: 10rpx; color: #526267; font-size: 23rpx; font-weight: 700; }
.form-input, .form-picker { height: 78rpx; padding: 0 20rpx; border-radius: 16rpx; background: #f3f7f6; font-size: 26rpx; line-height: 78rpx; }
.form-hint { display: block; margin-top: 8rpx; color: #849297; font-size: 20rpx; line-height: 1.5; }