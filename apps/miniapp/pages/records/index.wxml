<view class="page">
  <view class="section-title"><text>数据记录</text><button class="secondary-btn" style="margin:0;width:auto;padding:10rpx 22rpx" bindtap="goAdd">新增</button></view>
  <scroll-view class="filter-bar" scroll-x="true">
    <text class="filter-chip {{activePlatform === item ? 'active' : ''}}" wx:for="{{platforms}}" wx:key="*this" bindtap="selectPlatform" data-platform="{{item}}">{{item}}</text>
  </scroll-view>

  <block wx:if="{{records.length}}">
    <view class="card" wx:for="{{records}}" wx:key="id">
      <view class="card-row" bindtap="goEdit" data-id="{{item.id}}">
        <view>
          <text class="card-title">{{item.name}}</text>
          <text class="card-sub">{{item.platform}} · {{item.recordType === 'creator' ? '达人合作' : '自营内容'}}</text>
        </view>
        <text class="badge">{{item.review.action}}</text>
      </view>
      <view class="metrics">
        <view class="metric"><text class="metric-label">成本</text><text class="metric-value">{{item.costText}}</text></view>
        <view class="metric"><text class="metric-label">互动</text><text class="metric-value">{{item.interactionText}}</text></view>
        <view class="metric"><text class="metric-label">CPE</text><text class="metric-value">{{item.cpeText}}</text></view>
        <view class="metric"><text class="metric-label">ROAS</text><text class="metric-value">{{item.roasText}}</text></view>
      </view>
      <button class="danger-btn" bindtap="deleteRecord" data-id="{{item.id}}">删除</button>
    </view>
  </block>
  <view class="card empty" wx:else>
    <text class="empty-title">当前平台暂无记录</text>
    <text class="empty-sub">可以切换平台或新增一条数据。</text>
  </view>
</view>